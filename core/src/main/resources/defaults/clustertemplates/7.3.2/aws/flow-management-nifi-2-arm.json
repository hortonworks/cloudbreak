{
  "name": "7.3.2 - Flow Management - NiFi 2 - Heavy Duty (ARM) for AWS",
  "description": "",
  "type": "FLOW_MANAGEMENT",
  "featureState": "INTERNAL",
  "cloudPlatform": "AWS",
  "distroXTemplate": {
    "cluster": {
      "blueprintName": "7.3.2 - NiFi 2 - Flow Management Heavy Duty with Apache NiFi, Apache NiFi Registry, Schema Registry"
    },
    "architecture": "arm64",
    "externalDatabase": {
      "availabilityType": "HA"
    },
    "instanceGroups": [
      {
        "nodeCount": 1,
        "name": "management",
        "type": "GATEWAY",
        "recoveryMode": "MANUAL",
        "template": {
          "instanceType": "m7g.2xlarge",
          "fallbackInstanceTypes": ["m8g.2xlarge", "m6g.2xlarge"],
          "attachedVolumes": [
            {
              "size": 100,
              "count": 1,
              "type": "standard"
            }
          ]
        }
      },
      {
        "nodeCount": 3,
        "name": "nifi",
        "type": "CORE",
        "recoveryMode": "MANUAL",
        "template": {
          "instanceType": "m7g.2xlarge",
          "fallbackInstanceTypes": ["m8g.2xlarge", "m6g.2xlarge"],
          "rootVolume": {
            "size": 150
          },
          "attachedVolumes": [
            {
              "size": 1000,
              "count": 4,
              "type": "gp3"
            }
          ]
        }
      },
      {
        "nodeCount": 3,
        "name": "zk",
        "type": "CORE",
        "recoveryMode": "MANUAL",
        "template": {
          "instanceType": "m7g.xlarge",
          "fallbackInstanceTypes": ["m8g.xlarge", "m6g.xlarge"],
          "rootVolume": {
            "size": 100
          },
          "attachedVolumes": [
            {
              "size": 100,
              "count": 1,
              "type": "standard"
            }
          ]
        }
      }
    ]
  }
}
