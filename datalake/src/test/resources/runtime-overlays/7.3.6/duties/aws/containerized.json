{
  "cluster": {
    "blueprintName": "7.3.3 - SDX Containerized: Apache Hive Metastore, Apache Ranger, Apache Atlas",
    "validateBlueprint": false
  },
  "customDomain": {
    "domainName": "cloudera.site",
    "hostgroupNameAsHostname": true
  },
  "instanceGroups": [
    {
      "name": "master",
      "template": {
        "instanceType": "r5.2xlarge",
        "fallbackInstanceTypes": [ "r5a.2xlarge", "r6i.2xlarge" ],
        "attachedVolumes": [
          {
            "count": 1,
            "size": 512,
            "type": "gp3"
          }
        ]
      },
      "nodeCount": 1,
      "type": "GATEWAY",
      "recoveryMode": "MANUAL",
      "recipeNames": []
    }
  ]
}
